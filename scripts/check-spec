#!/bin/sh
# Model-check the specs in spec/ against every configuration they must pass
# or fail. Each configuration is a spec's .cfg with edits applied.
#
#   scripts/check-spec                     every check
#   scripts/check-spec NAME...             the named checks
#   scripts/check-spec --except NAME...    every check but the named ones
#   scripts/check-spec --list              the check names
#
# The fixed model must pass in both grace modes, at three devices and three
# groups, and with claims or the restart outage switched on, at two of each.
# Each Bug constant, set alone, restores a defect, and the property that
# defect broke must fail. A variant that passes means the spec has lost the
# ability to find that bug.
#
# Liveness costs far more than safety, so the two larger fixed models are
# checked in two runs each, and CI runs the liveness halves as jobs of their
# own.
set -eu
cd "$(dirname "$0")/.."

mode=all
case "${1:-}" in
    --list) mode=list ;;
    --except) mode=except; shift ;;
    "") ;;
    *) mode=only ;;
esac
names=" $* "
seen=" "

# Whether to run the check named $1.
selected() {
    seen="$seen$1 "
    case "$mode" in
        all) return 0 ;;
        list) echo "$1"; return 1 ;;
        only) case "$names" in *" $1 "*) return 0 ;; esac; return 1 ;;
        except) case "$names" in *" $1 "*) return 1 ;; esac; return 0 ;;
    esac
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp spec/HeadDaemon.tla spec/Election.tla "$work/"
failed=0
module=HeadDaemon
# TLC flags for the next checks. A liveness-only run checks its temporal
# properties once, at the end, rather than at intervals.
flags=

# check NAME EXPECT SED-ARGS...
# EXPECT is "pass", or TLC's line for the violation. $module names
# the spec and the config the edits apply to.
check() {
    name=$1
    expect=$2
    shift 2
    selected "$name" || return 0
    # The empty script keeps sed from reading the file as its script when a
    # check has no edits.
    sed -e '' "$@" "spec/$module.cfg" > "$work/$name.cfg"
    # shellcheck disable=SC2086 # $flags is a list of flags
    if scripts/tlc -workers auto $flags -metadir "$work/meta-$name" \
        -config "$work/$name.cfg" "$work/$module.tla" > "$work/$name.out" 2>&1; then
        status=0
    else
        status=$?
    fi
    states=$(grep -o '[0-9]* distinct states found' "$work/$name.out" | tail -1)
    if [ "$expect" = pass ] && [ "$status" -eq 0 ]; then
        echo "ok    $name ($states)"
    elif [ "$expect" != pass ] && [ "$status" -ne 0 ] && grep -qF "$expect" "$work/$name.out"; then
        echo "ok    $name: $expect"
    else
        echo "FAIL  $name: expected '$expect', TLC exited $status"
        tail -40 "$work/$name.out" | sed 's/^/      /'
        failed=1
    fi
}

nograce="s/GraceDeferred = TRUE/GraceDeferred = FALSE/"
big="s/Gpus = {g1, g2}/Gpus = {g1, g2, g3}/"
bigpgs="s/MaxPgs = 2/MaxPgs = 3/"
safety="s/^PROPERTIES.*/PROPERTIES GraceHoldsActors SessionKeepsActors/"
liveness="s/^PROPERTIES.*/PROPERTIES NoStall AdoptedBecomeKnown/"
typeonly="s/^INVARIANTS.*/INVARIANTS TypeOK/"

check fixed-grace-safety pass -e "$big" -e "$bigpgs" -e "$safety"
flags="-lncheck final"
check fixed-grace-liveness pass -e "$big" -e "$bigpgs" -e "$typeonly" -e "$liveness"
flags=
check fixed-nograce pass \
    -e 's/Gpus = {g1, g2}/Gpus = {g1, g2, g3}/' -e 's/MaxPgs = 2/MaxPgs = 3/' \
    -e "$nograce"

check bug-account-pgs-only "Invariant NoDoubleAlloc is violated" \
    -e 's/BugAccountPgsOnly = FALSE/BugAccountPgsOnly = TRUE/' -e "$nograce" \
    -e 's/^INVARIANTS.*/INVARIANTS TypeOK NoDoubleAlloc/' -e '/^PROPERTIES/d'
check bug-no-place-on-exit "Temporal properties were violated" \
    -e 's/BugNoPlaceOnExit = FALSE/BugNoPlaceOnExit = TRUE/' -e "$nograce" \
    -e 's/^INVARIANTS.*/INVARIANTS TypeOK/' -e 's/^PROPERTIES.*/PROPERTIES NoStall/'
check bug-no-orphan-reap "Temporal properties were violated" \
    -e 's/BugNoOrphanReap = FALSE/BugNoOrphanReap = TRUE/' \
    -e 's/^INVARIANTS.*/INVARIANTS TypeOK/' -e 's/^PROPERTIES.*/PROPERTIES NoStall/'
check bug-kill-during-grace "Action property GraceHoldsActors is violated" \
    -e 's/BugKillDuringGrace = FALSE/BugKillDuringGrace = TRUE/' \
    -e 's/^INVARIANTS.*/INVARIANTS TypeOK/' -e 's/^PROPERTIES.*/PROPERTIES GraceHoldsActors/'
check bug-reap-reconnected "Action property SessionKeepsActors is violated" \
    -e 's/BugReapReconnected = FALSE/BugReapReconnected = TRUE/' \
    -e 's/^INVARIANTS.*/INVARIANTS TypeOK/' -e 's/^PROPERTIES.*/PROPERTIES SessionKeepsActors/'
check bug-stale-timer "Action property GraceHoldsActors is violated" \
    -e 's/BugStaleTimer = FALSE/BugStaleTimer = TRUE/' \
    -e 's/^INVARIANTS.*/INVARIANTS TypeOK/' -e 's/^PROPERTIES.*/PROPERTIES GraceHoldsActors/'

check fixed-claims-safety pass -e 's/ModelClaims = FALSE/ModelClaims = TRUE/' -e "$safety"
flags="-lncheck final"
check fixed-claims-liveness pass -e 's/ModelClaims = FALSE/ModelClaims = TRUE/' \
    -e "$typeonly" -e "$liveness"
flags=
check fixed-outage pass -e 's/ModelOutage = FALSE/ModelOutage = TRUE/'

claims="s/ModelClaims = FALSE/ModelClaims = TRUE/"
outage="s/ModelOutage = FALSE/ModelOutage = TRUE/"
only() { echo "s/^INVARIANTS.*/INVARIANTS TypeOK $1/"; }

check bug-claim-spill "Invariant ClaimFence is violated" \
    -e "$claims" -e 's/BugClaimSpill = FALSE/BugClaimSpill = TRUE/' \
    -e "$(only ClaimFence)" -e '/^PROPERTIES/d'
check bug-claim-kept "Invariant ClaimHeld is violated" \
    -e "$claims" -e 's/BugClaimKept = FALSE/BugClaimKept = TRUE/' \
    -e "$(only ClaimHeld)" -e '/^PROPERTIES/d'
check bug-no-rotate "Invariant RankZeroOnDriver is violated" \
    -e "$claims" -e 's/BugNoRotate = FALSE/BugNoRotate = TRUE/' \
    -e "$(only RankZeroOnDriver)" -e '/^PROPERTIES/d'
check bug-no-redial "Invariant NoFalseDeath is violated" \
    -e "$outage" -e 's/BugNoRedial = FALSE/BugNoRedial = TRUE/' \
    -e "$(only NoFalseDeath)" -e '/^PROPERTIES/d'
check bug-unknown-ref-ready "Invariant NoFalseDeath is violated" \
    -e "$outage" -e 's/BugUnknownRefReady = FALSE/BugUnknownRefReady = TRUE/' \
    -e "$(only NoFalseDeath)" -e '/^PROPERTIES/d'

module=Election
check fixed-election pass
check bug-no-boot-wait "Action property StableHead is violated" \
    -e 's/BugNoBootWait = FALSE/BugNoBootWait = TRUE/' -e 's/^PROPERTIES.*/PROPERTIES StableHead/'

# A name that matches no check is a typo, and would otherwise skip silently.
if [ "$mode" = only ] || [ "$mode" = except ]; then
    for n in $names; do
        case "$seen" in
            *" $n "*) ;;
            *) echo "FAIL  no check is named $n"; failed=1 ;;
        esac
    done
fi

exit $failed
